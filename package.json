{
  "name": "premium-mobility-foundation",
  "version": "0.2.27",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "demo": "node examples/booking.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run test && npm run check:docs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "playwright test",
    "test:db": "node --test tests/integration/*.test.ts",
    "db:test:start": "node scripts/start-test-db.mjs",
    "test:auth": "node --test tests/supabase/*.test.mjs",
    "test:auth-ui": "node scripts/test-auth-ui.mjs",
    "supabase:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/list": "6.1.21",
    "@fullcalendar/luxon3": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "i18next": "26.4.2",
    "leaflet": "1.9.4",
    "lucide-react": "1.44.0",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "react-i18next": "17.0.13",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.20",
    "@types/luxon": "3.7.5",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
