# A base continua utilizável sem credenciais externas.
# Novas integrações devem acrescentar apenas nomes de variáveis, nunca segredos.

# Opcional no protótipo: Geoapify passa a ser a fonte principal quando a chave
# estiver configurada. Restrinja a chave aos domínios do app no painel.
VITE_GEOAPIFY_API_KEY=
VITE_GEOAPIFY_URL=https://api.geoapify.com/v1/geocode/autocomplete

# Fallback sem chave para desenvolvimento. O servidor público Photon não tem SLA.
VITE_PHOTON_URL=https://photon.komoot.io/api/
